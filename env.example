# ============================================================
# Mohammed Fazil Cattery — environment configuration
# Copy to .env.local for local development. NEVER commit real secrets.
# (This file is named env.example because .env* is write-protected in this
#  workspace — rename it to .env.example in your own environment if you prefer.)
# ============================================================

# --- Site -------------------------------------------------
# Canonical site URL (sitemap, Open Graph, canonical tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact (configure these — nothing is invented) ---
# WhatsApp number in international format, digits only, no "+".
# Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Phone number for tel: links. Keep digits / "+" only.
NEXT_PUBLIC_PHONE=

# Full Instagram profile URL, e.g. https://instagram.com/yourhandle
NEXT_PUBLIC_INSTAGRAM_URL=

# Shown as the location. Default: Madurai, Tamil Nadu, India
NEXT_PUBLIC_BUSINESS_CITY=Madurai, Tamil Nadu, India

# Optional verified street address. Leave empty if not verified.
# When empty, no "Directions" link is rendered anywhere.
NEXT_PUBLIC_BUSINESS_ADDRESS=

# --- MongoDB ----------------------------------------------
# MongoDB Atlas connection string (mongodb+srv://... or mongodb://...)
MONGODB_URI=

# Database name
MONGODB_DB=mohammed_fazil_cattery

# Seed clearly-labelled placeholder records when collections are empty.
SEED_ON_EMPTY=true

# --- Admin auth -------------------------------------------
# Admin account is created from the users collection (npm run seed).
# Fallback used when MongoDB is not configured:
ADMIN_EMAIL=admin@mohammedfazilcattery.local
# Generate with: npm run hash-password "your-strong-password"
ADMIN_PASSWORD_HASH=

# Secret used to sign the session cookie (32+ random chars).
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# --- Image upload storage ---------------------------------
# "local"      -> writes to public/uploads (development only)
# "cloudinary" -> Cloudinary driver (production-ready)
IMAGE_STORAGE_DRIVER=local

# Cloudinary (only when IMAGE_STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# --- Upload limits ----------------------------------------
MAX_UPLOAD_BYTES=8388608
