# ============================================================
# Mohammed Fazil Cattery — environment configuration
# Copy to .env.local for local development. NEVER commit real secrets.
# ============================================================

# --- Site -------------------------------------------------
# Canonical site URL (sitemap, Open Graph, canonical tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact (configure these — nothing is invented) ---
# WhatsApp number in international format, digits only, no "+".
# Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Phone number for tel: links. Keep digits / "+" only.
NEXT_PUBLIC_PHONE=

# Full Instagram profile URL, e.g. https://instagram.com/yourhandle
NEXT_PUBLIC_INSTAGRAM_URL=

# Shown as the location. Default: Madurai, Tamil Nadu, India
NEXT_PUBLIC_BUSINESS_CITY=Madurai, Tamil Nadu, India

# Optional verified street address. Leave empty if not verified.
# When empty, no "Directions" link is rendered anywhere.
NEXT_PUBLIC_BUSINESS_ADDRESS=

# --- Supabase (PostgreSQL database + authentication) -------
# Project URL + publishable (anon) key — safe for the browser.
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY privileged key. Authorizes the Next.js API layer to read/write
# tables regardless of the caller's RLS view; real authorization is enforced
# in code (session + admins-table check) and by the RLS policies for any
# direct table access. Use the new-style secret key (sb_secret_…) or the
# legacy service_role key. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy name accepted as a fallback:
# SUPABASE_SERVICE_ROLE_KEY=

# Seed clearly-labelled placeholder records when tables are empty
# (development only — production never seeds).
SEED_ON_EMPTY=true

# --- Admin auth -------------------------------------------
# Production admins are Supabase Auth users listed in the `admins` table
# (see scripts/supabase-setup.mjs and README → Admin setup). Create the two
# accounts by running that script locally with the credentials above.
#
# Secret used to sign the app session cookie (32+ random chars).
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# --- Image upload storage (Cloudinary — production) --------
# Cloudinary is the ONLY image storage provider. PostgreSQL stores metadata
# (imageUrl / publicId); binaries go to the kittens/, products/ and gallery/
# folders in the Cloudinary account.
#
# Provide either the three variables or CLOUDINARY_URL. SERVER-ONLY — never
# prefix with NEXT_PUBLIC_, never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative single-variable form: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=

# Optional override: "cloudinary" | "local" (local is for development only)
IMAGE_STORAGE_DRIVER=

# --- Upload limits ----------------------------------------
MAX_UPLOAD_BYTES=8388608
