# ============================================================
# Mohammed Fazil Cattery — environment configuration
# Copy to .env.local for local development. NEVER commit real secrets.
# (This file is named env.example because .env* is write-protected in this
#  workspace — rename it to .env.example in your own environment if you prefer.)
# ============================================================

# --- Site -------------------------------------------------
# Canonical site URL (sitemap, Open Graph, canonical tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact (configure these — nothing is invented) ---
# WhatsApp number in international format, digits only, no "+".
# Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Phone number for tel: links. Keep digits / "+" only.
NEXT_PUBLIC_PHONE=

# Full Instagram profile URL, e.g. https://instagram.com/yourhandle
NEXT_PUBLIC_INSTAGRAM_URL=

# Shown as the location. Default: Madurai, Tamil Nadu, India
NEXT_PUBLIC_BUSINESS_CITY=Madurai, Tamil Nadu, India

# Optional verified street address. Leave empty if not verified.
# When empty, no "Directions" link is rendered anywhere.
NEXT_PUBLIC_BUSINESS_ADDRESS=

# --- Firebase (database + auth + image storage) -----------
# Public web-app config — safe to expose (identifies the project only).
# Firebase Console → Project settings → General → "Your apps" → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SERVER-ONLY service-account credentials (Firebase Admin SDK).
# Firebase Console → Project settings → Service accounts → Generate new
# private key. Copy the three values below from the downloaded JSON.
# NEVER prefix these with NEXT_PUBLIC_ — they must stay server-side.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the key on ONE line; the app converts literal \n sequences to newlines.
FIREBASE_PRIVATE_KEY=

# Seed clearly-labelled placeholder records when collections are empty
# (development only — production never seeds).
SEED_ON_EMPTY=true

# --- Admin auth -------------------------------------------
# Production admins are Firebase Auth users listed in the Firestore `admins`
# collection (see scripts/firebase-setup.mjs and README → Admin setup).
#
# Fallback accounts (work even before Firebase is configured) — one
# Administrator and one Owner. Generate hashes with:
#   npm run hash-password "your-strong-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# Secret used to sign the session cookie (32+ random chars).
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# --- Image upload storage (Cloudinary — production) --------
# Cloudinary is the ONLY image storage provider. Firestore stores metadata
# (imageUrl / publicId); binaries go to the kittens/, products/ and gallery/
# folders in the Cloudinary account.
#
# Provide either the three variables or CLOUDINARY_URL. SERVER-ONLY — never
# prefix with NEXT_PUBLIC_, never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative single-variable form: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=

# Optional override: "cloudinary" | "local" (local is for development only)
IMAGE_STORAGE_DRIVER=

# --- Upload limits ----------------------------------------
MAX_UPLOAD_BYTES=8388608
