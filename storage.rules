rules_version = '2';

// Mohammed Fazil Cattery — Firebase Storage security rules.
//
// Uploads: only authorised admins, only into the managed folders the app
// uses (kittens/, products/, gallery/, misc/). Public read keeps image URLs
// simple and fast. Client deletion is blocked — cleanup happens server-side
// through the Admin SDK after a Firestore record is removed.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // NOTE: Storage rules cannot query Firestore, so admin membership is
    // asserted via Firebase Auth custom claims (`admin == true`). The setup
    // script (scripts/firebase-setup.mjs) sets this claim for every admin.
    function isCatteryAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validImage() {
      return request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    match /kittens/{fileName} {
      allow read: if true;
      allow create, update: if isCatteryAdmin() && validImage();
      allow delete: if false;
    }

    match /products/{fileName} {
      allow read: if true;
      allow create, update: if isCatteryAdmin() && validImage();
      allow delete: if false;
    }

    match /gallery/{fileName} {
      allow read: if true;
      allow create, update: if isCatteryAdmin() && validImage();
      allow delete: if false;
    }

    match /misc/{fileName} {
      allow read: if true;
      allow create, update: if isCatteryAdmin() && validImage();
      allow delete: if false;
    }

    // Everything else: deny by default (no direct bucket-wide access).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
