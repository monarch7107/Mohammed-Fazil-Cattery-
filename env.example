# ============================================================
# Mohammed Fazil Cattery — environment configuration
# Copy to .env.local for local development. NEVER commit real secrets.
# ============================================================

# --- Site -------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact (configure these — nothing is invented) ---
# WhatsApp number in international format, digits only, no "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_BUSINESS_CITY=Madurai, Tamil Nadu, India
NEXT_PUBLIC_BUSINESS_ADDRESS=

# --- Firebase / Firestore ---------------------------------
# Create a Firebase project and generate a service account for the server.
# Keep the private key server-only; NEVER prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key. In Vercel, keep the \n escapes intact
# or paste a single-line value; the app converts escaped newlines automatically.
FIREBASE_PRIVATE_KEY=

# Seed clearly-labelled placeholder records when all Firestore collections are empty.
SEED_ON_EMPTY=true

# --- Admin auth -------------------------------------------
# Two independent admin accounts are supported:
# Administrator -> ADMIN_EMAIL + ADMIN_PASSWORD_HASH
# Owner         -> OWNER_EMAIL + OWNER_PASSWORD_HASH
# Generate hashes with: npm run hash-password "your-strong-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# Secret used to sign the session cookie (32+ random chars).
AUTH_SECRET=

# --- Image upload storage ---------------------------------
# "local"      -> writes to public/uploads (development only)
# "cloudinary" -> Cloudinary driver (recommended for Vercel persistence)
IMAGE_STORAGE_DRIVER=local

# Cloudinary (only when IMAGE_STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# --- Upload limits ----------------------------------------
MAX_UPLOAD_BYTES=8388608
