rules_version = '2';

// Mohammed Fazil Cattery — Firestore security rules.
//
// Public: read-only access to kittens, products and gallery (public pages).
// Admins: explicit `admins` documents authorise full write access.
// Nobody: can read or modify `admins` directly from the client — admin
//         membership is managed via the Admin SDK / console only.
//
// Images live in Cloudinary (server-side signed uploads from the Next.js
// API layer); Firebase Storage is intentionally not part of this project.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin membership: an explicit `admins/{uid}` document with
    // role == "admin" and active == true. The setup script creates one per
    // admin account; the `admin` custom claim mirrors it for defense in
    // depth (claim + Firestore document must both agree).
    function isAdmin() {
      return signedIn() &&
        request.auth.token.admin == true &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // ---- Public content: world-readable, admin-writable ----------------
    match /kittens/{kittenId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- Admin registry: never readable or writable by clients ---------
    match /admins/{adminId} {
      allow read, write: if false;
    }

    // ---- Everything else: deny by default -------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
